# Application Configuration
PROJECT_NAME="Real-Time AI Interview Cheat Detection System"
DEBUG=True

# Database Configuration (PostgreSQL URL, or falls back to SQLite if not provided/reachable)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/cheat_detection
DATABASE_URL=sqlite:///./cheat_detection.db

# JWT & Authentication
JWT_SECRET=super-secret-key-change-in-production-realtime-cheat-detection-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Monitoring & Detection Thresholds
SMALL_PASTE_THRESHOLD=50
MEDIUM_PASTE_THRESHOLD=300
TAB_SWITCH_WEIGHT=5
LONG_TAB_SWITCH_WEIGHT=10
LARGE_PASTE_WEIGHT=10
REPEATED_LARGE_PASTE_WEIGHT=15
TYPING_ANOMALY_WEIGHT=10
CODE_SIMILARITY_WEIGHT=25
MULTI_SIGNAL_BONUS_WEIGHT=10
